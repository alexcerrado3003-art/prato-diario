# Prato Diário — o que vai em cada lugar. NÃO coloque valores reais neste arquivo.

# ---- No celular (tela "Conectar ao seu banco" ou pwa/config.js). Valores públicos.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx      # ou a chave "anon" (começa com eyJ)

# ---- Só no Supabase: Edge Functions → Secrets. NUNCA no celular nem no config.js.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx              # platform.claude.com → API Keys
CLAUDE_MODEL=claude-sonnet-5-5                 # opcional; fotos, laudos e análises
CLAUDE_MODEL_QUICK=claude-haiku-5-5            # opcional; dicas rápidas
AI_DAILY_LIMIT=60                              # opcional; análises por dia
ALLOWED_EMAILS=seu@email.com                   # opcional; só esses e-mails usam a IA
